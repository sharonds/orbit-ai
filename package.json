{
  "name": "orbit-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "release": "changeset publish --tag alpha",
    "release:dry-run": "pnpm -r build && node scripts/release-dry-run.mjs",
    "release:verify-artifacts": "node scripts/verify-package-artifacts.mjs",
    "test:doc-hygiene": "node scripts/check-doc-hygiene.mjs",
    "test:release-workflow": "node --test scripts/release-workflow.test.mjs",
    "test": "pnpm test:doc-hygiene && pnpm test:release-workflow && turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "hono": "^4.12.18",
      "ip-address": "^10.1.1",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "vite": "^7.3.2",
      "postcss": "^8.5.10",
      "ws": "^8.20.1"
    }
  }
}
